{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hyvo run.json v1",
  "description": "Generated from RunV1 in packages/schema (pnpm --filter @hyvo/schema gen); the format is docs/RUN_FORMAT.md. Covers the per-field rules only: cross-field rules (sums, references, one action per agent per round, action consistency) are checked by RunV1 itself.",
  "type": "object",
  "properties": {
    "runId": {
      "type": "string",
      "pattern": "^run_[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "version": {
      "type": "number",
      "const": 1
    },
    "createdAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "status": {
      "type": "string",
      "enum": [
        "complete",
        "partial"
      ]
    },
    "stopReason": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "max_cost_usd",
            "max_llm_calls",
            "timeout"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "scenario": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "seedText": {
          "type": "string",
          "minLength": 0,
          "maxLength": 4000
        },
        "seedSources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "url",
                  "onchain",
                  "user"
                ]
              },
              "ref": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "ref"
            ],
            "additionalProperties": false
          }
        },
        "injectedEvents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "round": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "text": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              }
            },
            "required": [
              "round",
              "text"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "title",
        "seedText",
        "seedSources",
        "injectedEvents"
      ],
      "additionalProperties": false
    },
    "world": {
      "type": "object",
      "properties": {
        "chainId": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "forkBlock": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "pools": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "address": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "token0": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "token1": {
                "type": "string",
                "pattern": "^0x[0-9a-fA-F]{40}$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "v2-test",
                  "real"
                ]
              },
              "feeBps": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10000
              }
            },
            "required": [
              "address",
              "token0",
              "token1",
              "kind",
              "feeBps"
            ],
            "additionalProperties": false
          }
        },
        "token": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "symbol": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "address",
            "symbol",
            "name",
            "decimals"
          ],
          "additionalProperties": false
        },
        "quote": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            },
            "symbol": {
              "type": "string"
            },
            "decimals": {
              "type": "integer",
              "minimum": 0,
              "maximum": 255
            }
          },
          "required": [
            "address",
            "symbol",
            "decimals"
          ],
          "additionalProperties": false
        },
        "initialMarket": {
          "type": "object",
          "properties": {
            "price": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
            },
            "reserve0": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
            },
            "reserve1": {
              "type": "string",
              "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
            },
            "holders": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "price",
            "reserve0",
            "reserve1",
            "holders"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "chainId",
        "forkBlock",
        "pools",
        "token",
        "quote",
        "initialMarket"
      ],
      "additionalProperties": false
    },
    "crowd": {
      "type": "object",
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "personaMix": {
          "type": "object",
          "properties": {
            "sniper": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "holder": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "panic_seller": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "skeptic": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "swing_trader": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "whale": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "kol_follower": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "market_maker_bot": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "stock_token_holder": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "newcomer": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "clone": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "sniper",
            "holder",
            "panic_seller",
            "skeptic"
          ],
          "additionalProperties": false
        },
        "model": {
          "type": "object",
          "properties": {
            "agents": {
              "type": "string",
              "minLength": 1
            },
            "report": {
              "type": "string",
              "minLength": 1
            },
            "temperature": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "agents",
            "report",
            "temperature"
          ],
          "additionalProperties": false
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "agentId": {
                "type": "string",
                "pattern": "^a[0-9]{2,4}$"
              },
              "handle": {
                "type": "string",
                "pattern": "^@[a-z0-9_]{3,30}$"
              },
              "persona": {
                "type": "string",
                "enum": [
                  "sniper",
                  "holder",
                  "panic_seller",
                  "skeptic",
                  "swing_trader",
                  "whale",
                  "kol_follower",
                  "market_maker_bot",
                  "stock_token_holder",
                  "newcomer",
                  "clone"
                ]
              },
              "startEth": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              },
              "startTokens": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              }
            },
            "required": [
              "agentId",
              "handle",
              "persona",
              "startEth",
              "startTokens"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "size",
        "personaMix",
        "model",
        "agents"
      ],
      "additionalProperties": false
    },
    "rounds": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "n": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "posts": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[pc][0-9]+$"
                },
                "agentId": {
                  "type": "string",
                  "pattern": "^a[0-9]{2,4}$"
                },
                "text": {
                  "type": "string"
                },
                "replyTo": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[pc][0-9]+$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "likes": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "agentId",
                "text",
                "replyTo",
                "likes"
              ],
              "additionalProperties": false
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "agentId": {
                  "type": "string",
                  "pattern": "^a[0-9]{2,4}$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "swap_buy",
                    "swap_sell",
                    "hold",
                    "check_market"
                  ]
                },
                "amountIn": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "amountOut": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "txHash": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^0x[0-9a-f]{64}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "ok",
                    "reverted",
                    "invalid"
                  ]
                },
                "note": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "agentId",
                "kind",
                "amountIn",
                "amountOut",
                "txHash",
                "status",
                "note"
              ],
              "additionalProperties": false
            }
          },
          "market": {
            "type": "object",
            "properties": {
              "price": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              },
              "reserve0": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              },
              "reserve1": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              },
              "holders": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "price",
              "reserve0",
              "reserve1",
              "holders"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "n",
          "posts",
          "actions",
          "market"
        ],
        "additionalProperties": false
      }
    },
    "report": {
      "type": "object",
      "properties": {
        "summary": {
          "type": "string",
          "minLength": 0,
          "maxLength": 1500
        },
        "turningPoint": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "round": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "why": {
                  "type": "string",
                  "minLength": 0,
                  "maxLength": 800
                }
              },
              "required": [
                "round",
                "why"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "sentimentByRound": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          }
        },
        "objections": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 400
          }
        },
        "priceDrivers": {
          "maxItems": 5,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 0,
            "maxLength": 400
          }
        },
        "disclaimer": {
          "type": "string",
          "const": "Synthetic crowd reaction. Not a trading signal."
        },
        "flags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "summary",
        "turningPoint",
        "sentimentByRound",
        "objections",
        "priceDrivers",
        "disclaimer",
        "flags"
      ],
      "additionalProperties": false
    },
    "usage": {
      "type": "object",
      "properties": {
        "llmCalls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "inputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "outputTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costUsd": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "llmCalls",
        "inputTokens",
        "outputTokens",
        "costUsd"
      ],
      "additionalProperties": false
    },
    "question": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "resolvesAt": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "answers": {
          "type": "object",
          "properties": {
            "yes": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "no": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unsure": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "yes",
            "no",
            "unsure"
          ],
          "additionalProperties": false
        },
        "byAgent": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^a[0-9]{2,4}$"
          },
          "additionalProperties": {
            "type": "string",
            "enum": [
              "yes",
              "no",
              "unsure"
            ]
          }
        },
        "expectation": {
          "type": "string",
          "enum": [
            "yes",
            "no",
            "split"
          ]
        }
      },
      "required": [
        "text",
        "resolvesAt",
        "answers",
        "byAgent",
        "expectation"
      ],
      "additionalProperties": false
    },
    "rewind": {
      "type": "object",
      "properties": {
        "pool": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "block": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        },
        "hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "change": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "actual": {
          "minItems": 2,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "block": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
              },
              "price": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              },
              "reserveEth": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              },
              "reserveToken": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]*[1-9])?$"
              }
            },
            "required": [
              "block",
              "at",
              "price",
              "reserveEth",
              "reserveToken"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "pool",
        "block",
        "at",
        "hours",
        "change",
        "actual"
      ],
      "additionalProperties": false
    },
    "hash": {
      "type": "string",
      "pattern": "^0x[0-9a-f]{64}$"
    }
  },
  "required": [
    "runId",
    "version",
    "createdAt",
    "status",
    "stopReason",
    "scenario",
    "world",
    "crowd",
    "rounds",
    "report",
    "usage",
    "hash"
  ],
  "additionalProperties": false
}
