{
  "$schema": "../api/node_modules/wrangler/config-schema.json",
  // The web app on its own domain (apps/api/domains.json). An assets-only Worker: there is no script, so
  // every request is a static-asset request, free and unlimited on the Workers Free plan
  // (https://developers.cloudflare.com/workers/static-assets/billing-and-limitations/). The deploy
  // (`pnpm --filter @hyvo/api deploy:cloudflare --yes`) builds dist/ and attaches the custom domains with
  // `--domain`, which Wrangler can do for a Worker but not for a Pages project. The Pages project keeps
  // serving *.pages.dev, which sends visitors on to the domain.
  "name": "hyvo-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    // Every path the app routes itself, such as /run/:id, gets index.html.
    "not_found_handling": "single-page-application"
  },
  // Only the custom domains serve it.
  "workers_dev": false,
  "preview_urls": false
}
