# Build settings for the deployed site. No secrets here: everything in this file ends up in the public bundle.
# The public repository: fill it in when the repo goes public, and the footer links to it (AGPL, docs/OPEN_ITEMS.md item 1).
VITE_SOURCE_URL=
# The site's own address, for the share image's URL. The deploy sets it to the custom domain (apps/api/domains.json).
VITE_SITE_URL=https://hyvo.pages.dev
# Set by the deploy once the site has its own domain: the host to send visitors to, and the hosts that send them.
VITE_SITE_HOST=
VITE_SITE_REDIRECT_HOSTS=
