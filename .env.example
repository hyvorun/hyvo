# Copy to .env (engine/runner) and fill in. Never commit .env.
# Worker secrets are set with `wrangler secret put <NAME>` instead (see apps/api).
# Keep comments on their own lines: dotenv parsers read "KEY=  # note" as the value "# note".

# ---------------------------------------------------------------------------
# Engine / runner
# ---------------------------------------------------------------------------
# Any OpenAI-SDK-compatible endpoint. Leave LLM_API_KEY empty to use the offline
# rules model (no network, zero cost, labeled "offline/rules-v1" in run.json).
# Cloudflare Workers AI through the API needs no provider key: LLM_API_KEY=<the Worker's LLM_TOKEN>,
# LLM_BASE_URL=<API URL>/internal/llm/v1, LLM_MODEL_NAME=@cf/meta/llama-3.1-8b-instruct-fp8-fast,
# REPORT_MODEL_NAME=@cf/meta/llama-3.3-70b-instruct-fp8-fast (pnpm --filter @hyvo/api deploy:cloudflare
# writes these). Another example: LLM_BASE_URL=https://api.deepseek.com and LLM_MODEL_NAME=deepseek-flash
LLM_API_KEY=
LLM_BASE_URL=
# Model for the agents (cheap).
LLM_MODEL_NAME=
# Model for the report agent (stronger). Empty = same as LLM_MODEL_NAME.
REPORT_MODEL_NAME=
# Prices in USD per 1M tokens, only needed for models missing from engine/hyvo/llm/pricing.py.
LLM_PRICE_INPUT_PER_M=
LLM_PRICE_OUTPUT_PER_M=
REPORT_PRICE_INPUT_PER_M=
REPORT_PRICE_OUTPUT_PER_M=
# Optional in Stage 1.
ZEP_API_KEY=
# Robinhood Chain RPC for anvil forks, e.g. https://robinhood.drpc.org. The official RPC is
# DNS-blocked by some ISPs (docs/OPEN_ITEMS.md items 3 and 14).
# Empty = local anvil with chain ID 4663 and no fork.
RH_RPC_URL=
# Optional second archive-capable RPC (e.g. Alchemy).
RH_RPC_URL_FALLBACK=
HYVO_API_URL=
RUNNER_TOKEN=
MAX_COST_USD_DEFAULT=0.50
MAX_LLM_CALLS_DEFAULT=2000
# The site's address, for the links in post threads. Empty = https://hyvo.pages.dev
HYVO_SITE_URL=
# Narrative Engine (hyvo daily --seed-packs). News feeds, comma-separated; empty = the list in engine/hyvo/narrative/rss.py.
NARRATIVE_RSS_URLS=
# Optional: Farcaster casts through Neynar. Empty = no casts. docs/OPEN_ITEMS.md item 8.
NEYNAR_API_KEY=

# Wallet Clone: reads a signed-in wallet's own trades (docs/OPEN_ITEMS.md item 24). Free key at https://dev.blockscout.com.
BLOCKSCOUT_API_KEY=
# BLOCKSCOUT_API_URL=https://api.blockscout.com/4663/api/v2

# ---------------------------------------------------------------------------
# Worker (set as Wrangler secrets / vars; listed here for reference only)
# ---------------------------------------------------------------------------
ATTESTER_PRIVATE_KEY=
RUNNER_TOKEN=
LLM_TOKEN=
ARTIFACT_SIGNING_KEY=
SIWE_DOMAIN=
ORACLE_ADDRESS=
PAYMENT_ROUTER_ADDRESS=
USDG_ADDRESS=
HYVO_TOKEN_ADDRESS=
TREASURY_ADDRESS=
HOLDER_MIN=
FREE_RUNS_PER_MONTH=
DAILY_SPEND_CAP_USD=
